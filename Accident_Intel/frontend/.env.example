# Base URL of the FastAPI backend.
# Leave empty to use the Vite dev-server proxy (vite.config.ts forwards /api
# to http://localhost:8000) — this also works behind hosted preview URLs.
VITE_API_BASE_URL=

# Set to "true" to use local mock data instead of the real backend.
# Set to "false" (or remove) to run against the project's real models.
VITE_MOCK_MODE=false

# Legacy name, still honoured: VITE_USE_MOCK
